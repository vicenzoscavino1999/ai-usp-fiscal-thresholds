* text=auto eol=lf

*.parquet binary
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
*.zip binary
*.xlsx binary
*.sav binary
*.dta binary

# These trees participate in byte-for-byte checksum contracts. Do not let a
# checkout policy rewrite their historical line endings.
reproducibility/reference/** binary
reproducibility/snapshot/** binary

# These two frozen blobs remain LF in Git. Materialize their historical CRLF
# byte contracts on every platform without changing the protected blobs.
reproducibility/reference/country_policy_classification_final.csv text eol=crlf
reproducibility/reference/monte_carlo_result.csv text eol=crlf
